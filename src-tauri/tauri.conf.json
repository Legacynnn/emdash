{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "emdash - dev",
  "version": "0.1.0",
  "identifier": "com.emdash.dev",
  "build": {
    "beforeDevCommand": "pnpm --filter emdash-dev-ui dev",
    "beforeBuildCommand": "pnpm --filter emdash-dev-ui build",
    "frontendDist": "./ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "emdash - dev",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 18, "y": 18 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFODBENDg4RTI5NkFENUIKUldSYnJaYmlpTlNBbm80YVloNnJWSTNRaE9hYy9YcUpRL0NMZTRyaG0wSk9DbTAzcmQ4ZTVmNHkK",
      "endpoints": [
        "https://updates.emdash.dev/latest.json?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ]
    }
  }
}
